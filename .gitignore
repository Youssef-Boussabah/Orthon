# CMake/build outputs; source .cmake modules remain visible.
build/
/build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
.ninja_deps
.ninja_log
build.ninja

# Native binaries and CUDA-generated outputs.
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.pyd
*.exe
*.out
*.cubin
*.ptx
*.fatbin

# Python build metadata, caches and virtual environments.
__pycache__/
*.py[cod]
*.egg-info/
dist/
_skbuild/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage/
.venv/
venv/
env/

# Local resolver state, not release input; preserve the existing file's bytes.
/uv.lock

# IDE/editor and OS files.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local environment secrets (example templates can be committed).
.env
.env.*
!.env.example

# Logs and external profiler captures.
*.log
*.ncu-rep
*.nsys-rep
*.qdrep
profiles/*.sqlite

# Example outputs and datasets; retain the intentional directory placeholder.
examples/results/*
!examples/results/.gitkeep
/data/
/datasets/

# Temporary installer/build directories.
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/
pytest-of-*/
tmp*/
